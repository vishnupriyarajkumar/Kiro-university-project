{
  "name": "pomodoro-session-logger",
  "version": "1.0.0",
  "description": "A CLI tool to log focus sessions, track productivity streaks, and analyze work patterns",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:property": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/property",
    "lint": "eslint src/ tests/ --ext .js"
  },
  "keywords": ["cli", "pomodoro", "productivity", "focus", "kiro"],
  "author": "vishnupriyarajkumar",
  "license": "MIT",
  "dependencies": {
    "chalk": "5.3.0",
    "commander": "12.1.0",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "eslint": "8.57.0",
    "fast-check": "3.22.0",
    "jest": "29.7.0"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node"
  }
}
