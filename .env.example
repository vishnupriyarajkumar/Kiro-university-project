# Pomodoro Session Logger — Environment Variables
# Copy this file to .env and fill in your values.
# .env is git-ignored; this file is safe to commit.

# ── MongoDB ────────────────────────────────────────────────────────────────────
# Connection string for your MongoDB instance.
# Defaults to a local database named "pomodoro" when not set.
MONGODB_URI=mongodb://localhost:27017/pomodoro

# ── Web Server ─────────────────────────────────────────────────────────────────
# Port the HTTP server listens on.
# Defaults to 3000 when not set.
PORT=3000

# ── Node Environment ───────────────────────────────────────────────────────────
# Set to "production" when deploying.
# Defaults to "development" when not set.
NODE_ENV=development
