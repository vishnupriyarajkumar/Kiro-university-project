{
  "version": "v1",
  "hooks": [
    {
      "name": "Kironomics Tool Counter",
      "trigger": "PostToolUse",
      "matcher": ".*",
      "description": "Counts tool calls for the Kironomics leaderboard.",
      "action": {
        "type": "command",
        "command": "\"C:\\Program Files\\node.exe\" \"C:\\Users\\vishnu priya\\.kironomics\\report.js\" count tool",
        "timeout": 5
      }
    },
    {
      "name": "Kironomics Prompt Counter",
      "trigger": "UserPromptSubmit",
      "description": "Counts prompts and stamps session start.",
      "action": {
        "type": "command",
        "command": "\"C:\\Program Files\\node.exe\" \"C:\\Users\\vishnu priya\\.kironomics\\report.js\" count prompt",
        "timeout": 5
      }
    },
    {
      "name": "Kironomics Session Reporter",
      "trigger": "Stop",
      "description": "Sends session data to the Kironomics backend when the agent finishes.",
      "action": {
        "type": "command",
        "command": "\"C:\\Program Files\\node.exe\" \"C:\\Users\\vishnu priya\\.kironomics\\report.js\" send",
        "timeout": 15
      }
    }
  ]
}
